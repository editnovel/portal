            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rename": {
            "description": "Section renames in id=title format (e.g. [\"s02=Chapter 1\"])",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reorder": {
            "description": "Comma-separated section ID order",
            "type": "string"
          },
          "retype": {
            "description": "Section type overrides in id=type format",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "workspace": {
            "default": "./work",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "editnovel_inspect_media",
      "description": "Inspect extracted images and dHash filtering verdicts with local thumbnail paths.",
