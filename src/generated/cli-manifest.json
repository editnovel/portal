        "type": "object"
      }
    },
    {
      "name": "editnovel_apply_rules",
      "description": "Ignore proper nouns/glossary terms, apply high-confidence spell fixes, or add regex replacement rules.",
      "inputSchema": {
        "properties": {
          "apply_spell": {
            "default": false,
            "type": "boolean"
          },
          "dry_run": {
            "default": false,
            "type": "boolean"
          },
          "find": {
            "type": "string"
          },
          "flags": {
            "default": "g",
            "type": "string"
          },
          "ignore_words": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "min_conf": {
            "default": 0.9,
            "type": "number"
          },
          "replace": {
            "type": "string"
          },
          "workspace": {
            "default": "./work",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "editnovel_build_epub",
      "description": "Build and validate the final EPUB 3 (or multi-volume omnibus) and optionally export a .editnovel v2 archive.",
      "inputSchema": {
        "properties": {
          "export_project": {
            "description": "Optional output .editnovel project archive path",
            "type": "string"
          },
          "out": {
            "description": "Output EPUB 3 file path",
            "type": "string"
          },
          "workspace": {
            "default": "./work",
            "type": "string"
          }
        },
        "required": [
          "out"
        ],
        "type": "object"
      }
    },
    {
      "name": "editnovel_verify_epub",
      "description": "Verify an EPUB 3 file for OCF mimetype rules, XML/XHTML well-formedness, image references, and EPUB 3 metadata.",
