            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "discard": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dry_run": {
            "default": false,
            "type": "boolean"
          },
          "keep": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "workspace": {
            "default": "./work",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
